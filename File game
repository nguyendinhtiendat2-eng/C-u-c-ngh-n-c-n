import random
import time
import streamlit as st

# Cấu hình trang
st.set_page_config(
    page_title="Game Câu Cá Streamlit", page_icon="🎣", layout="wide"
)

# ---------------------------------------------------------
# 1. KHỞI TẠO STATE (LƯU TÊN, ĐIỂM, NHẬT KÝ)
# ---------------------------------------------------------
if "player_name" not in st.session_state:
    st.session_state.player_name = ""
if "score" not in st.session_state:
    st.session_state.score = 0
if "logs" not in st.session_state:
    st.session_state.logs = []
if "game_started" not in st.session_state:
    st.session_state.game_started = False

st.title("🎣 Game Câu Cá Vui Nhộn")

# ---------------------------------------------------------
# 2. BẢNG NHẬP TÊN NGƯỜI CHƠI
# ---------------------------------------------------------
if not st.session_state.game_started:
    st.subheader("👤 Đăng Ký Cần Thủ")
    name_input = st.text_input(
        "Nhập tên của bạn để bắt đầu:",
        value=st.session_state.player_name,
        placeholder="Ví dụ: Cần Thủ Tiến Đạt",
    )

    if st.button("🚀 Bắt Đầu Chơi", type="primary"):
        if name_input.strip() != "":
            st.session_state.player_name = name_input.strip()
            st.session_state.game_started = True
            st.rerun()
        else:
            st.warning("Vui lòng nhập tên trước khi bắt đầu!")
    st.stop()  # Dừng giao diện bên dưới cho đến khi nhập tên

# ---------------------------------------------------------
# 3. QUẢN LÝ NHẠC NỀN (FILE NGOÀI HOẶC LINK URL)
# ---------------------------------------------------------
with st.sidebar:
    st.header("⚙️ Cấu Hình Âm Thanh")
    st.write(f"🎮 Người chơi: **{st.session_state.player_name}**")

    music_source = st.radio(
        "Nguồn nhạc nền:",
        ["File trong thư mục (background_music.mp3)", "Đường link URL ngoài"],
    )

    if music_source == "File trong thư mục (background_music.mp3)":
        try:
            with open("background_music.mp3", "rb") as f:
                st.audio(f.read(), format="audio/mp3", loop=True)
        except FileNotFoundError:
            st.info("Chưa có file `background_music.mp3` trong thư mục.")
    else:
        audio_url = st.text_input(
            "Nhập link nhạc (.mp3 / .ogg):",
            value="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3",
        )
        if audio_url:
            st.audio(audio_url, format="audio/mp3")

    st.divider()
    if st.button("🔄 Đổi Tên / Chơi Lại Từ Đầu"):
        st.session_state.game_started = False
        st.session_state.score = 0
        st.session_state.logs = []
        st.rerun()

# ---------------------------------------------------------
# 4. GIAO DIỆN CHÍNH & LOGIC GAME
# ---------------------------------------------------------
col_game, col_info = st.columns([2, 1])

# Danh sách hình ảnh GIF động minh họa (Sử dụng URL trực tuyến)
GIF_WAITING = "https://media.giphy.com/media/3o7abeG5620M3y95vO/giphy.gif"  # Cảnh thả câu
GIF_FISH = "https://media.giphy.com/media/l1J9I5K3C_I52jP_a/giphy.gif"  # Cảnh bắt được cá
GIF_JUNK = "https://media.giphy.com/media/26hkhPJ5hzd46K_68/giphy.gif"  # Rác/Giày cũ
GIF_IDLE = "https://images.unsplash.com/photo-1544551763-46a013bb70d5?w=600"  # Ảnh hồ nước tĩnh

with col_game:
    st.subheader(f"Cần thủ: {st.session_state.player_name}")

    # Bảng hiển thị điểm lớn
    st.metric(label="🏆 Tổng Điểm Tích Lũy", value=st.session_state.score)

    # Khung hiển thị GIF/Hình ảnh trạng thái
    img_placeholder = st.empty()
    img_placeholder.image(
        GIF_IDLE, caption="Sẵn sàng thả câu!", use_container_width=True
    )

    # Nút Thả Câu
    if st.button("🎣 Thả Lưỡi Câu!", type="primary", use_container_width=True):
        # Hiển thị GIF đang chờ cá cắn
        img_placeholder.image(
            GIF_WAITING,
            caption="Đang thả mồi xuống nước...",
            use_container_width=True,
        )

        with st.spinner("Cá đang xem xét mồi... 🌊"):
            time.sleep(2)  # Giả lập thời gian chờ

        # Tỷ lệ: 60% Cá, 25% Rác, 15% Hụt
        outcome = random.choices(
            ["fish", "junk", "nothing"], weights=[0.6, 0.25, 0.15]
        )[0]

        if outcome == "fish":
            fish_list = [
                ("Cá Rô Phi", 5),
                ("Cá Chép Vàng", 10),
                ("Cá Mập Con", 25),
                ("Rồng Biển", 50),
            ]
            caught_fish, pts = random.choice(fish_list)

            st.session_state.score += pts
            st.session_state.logs.insert(
                0,
                f"🎉 {st.session_state.player_name} câu được {caught_fish} (+{pts} điểm)",
            )

            # Đổi GIF thành cảnh dính cá
            img_placeholder.image(
                GIF_FISH,
                caption=f"Đỉnh quá! Trúng {caught_fish}!",
                use_container_width=True,
            )
            st.success(f"🎉 Bạn đã câu được **{caught_fish}** (+{pts} điểm)!")

            # Phát âm thanh hiệu ứng khi giật cá (tùy chọn)
            try:
                with open("catch_sound.mp3", "rb") as sf:
                    st.audio(sf.read(), format="audio/mp3", autoplay=True)
            except FileNotFoundError:
                pass

        elif outcome == "junk":
            st.session_state.logs.insert(
                0, f"👞 {st.session_state.player_name} câu phải chiếc giày cũ!"
            )
            img_placeholder.image(
                GIF_JUNK,
                caption="Toàn rác là rác...",
                use_container_width=True,
            )
            st.error("👞 Rất tiếc, bạn vừa kéo lên một chiếc giày cũ! (0 điểm)")

        else:
            st.session_state.logs.insert(
                0, f"🌊 Cá xào mồi rồi bơi mất..."
            )
            img_placeholder.image(
                GIF_IDLE, caption="Cá bơi mất rồi!", use_container_width=True
            )
            st.info("🌊 Cá ăn sạch mồi rồi bơi mất...")

with col_info:
    st.subheader("📜 Nhật Ký Đi Câu")
    if not st.session_state.logs:
        st.write("Chưa có lịch sử câu cá.")
    else:
        for log in st.session_state.logs[:8]:
            st.write(f"- {log}")
